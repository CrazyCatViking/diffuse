{
  "name": "diffuse-app",
  "version": "0.1.21",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform=wayland",
    "check:rpc-contract": "node ../scripts/check-rpc-contract.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" \"electron/**/*.ts\" \"scripts/**/*.mjs\" electron.vite.config.ts vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\" \"electron/**/*.ts\" \"scripts/**/*.mjs\" electron.vite.config.ts vitest.config.ts",
    "test": "vitest run --exclude electron/coreRpcIntegration.test.ts --exclude electron/repositorySliceRpcIntegration.test.ts --exclude electron/completeCoreParity.test.ts --exclude electron/nativeCoreIntegration.test.ts",
    "test:integration": "vitest run electron/coreRpcIntegration.test.ts",
    "test:rust-integration": "node scripts/run-rust-core-integration.mjs && vitest run electron/repositorySliceRpcIntegration.test.ts electron/completeCoreParity.test.ts",
    "test:native": "vitest run electron/nativeCoreIntegration.test.ts",
    "test:native:all": "pnpm smoke:native:node && pnpm test:native && pnpm smoke:native:electron",
    "test:all": "vitest run",
    "native:build": "cargo build --manifest-path ../Cargo.toml --workspace --locked && pnpm native:stage",
    "native:build:release": "cargo build --manifest-path ../Cargo.toml --workspace --release --locked && pnpm native:stage:release",
    "native:stage": "node scripts/stage-native-artifacts.mjs --profile debug",
    "native:stage:release": "node scripts/stage-native-artifacts.mjs --profile release",
    "smoke:native:node": "node scripts/smoke-native-addon.mjs",
    "smoke:native:electron": "node scripts/run-electron-native-smoke.mjs",
    "smoke:native:packaged": "node scripts/smoke-packaged-native.mjs",
    "prepare:electron": "node scripts/prepare-electron-package.mjs",
    "build": "pnpm check:rpc-contract && pnpm test && vue-tsc --noEmit && electron-vite build",
    "package": "pnpm native:build:release && pnpm build && pnpm prepare:electron && electron-builder --dir",
    "dist": "pnpm native:build:release && pnpm build && pnpm prepare:electron && electron-builder",
    "preview": "electron-vite preview"
  },
  "build": {
    "appId": "dev.diffuse.app",
    "productName": "Diffuse",
    "executableName": "diffuse",
    "artifactName": "diffuse-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.17.7",
    "@tanstack/vue-virtual": "^3.13.12",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron-vite": "^4.0.0",
    "pinia": "^3.0.3",
    "prettier": "^3.8.4",
    "sass": "^1.89.0",
    "vue": "^3.5.14",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vue/test-utils": "^2.4.11",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "happy-dom": "^20.11.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
